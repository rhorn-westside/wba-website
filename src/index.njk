---
layout: layouts/base.njk
title: false
description: Westside Baptist Academy is a K5–12 college-preparatory Christian school in Katy, Texas, and a ministry of Westside Baptist Church.
---

{# Wording comes from src/_data/home.json so it can be edited in the CMS.
   Phone, address, school day and service times come from site.json. #}

<section class="hero">
  <div class="wrap">
    <div class="hero__inner">
      <span class="hero__eyebrow">{{ home.hero.eyebrow }}</span>
      <h1>{{ home.hero.heading }}</h1>
      <p class="hero__lede">{{ site.purpose }}</p>
      <div class="btn-row">
        <a class="btn" href="{{ home.hero.primaryButton.url }}">{{ home.hero.primaryButton.label }}</a>
        <a class="btn btn--light" href="{{ home.hero.secondaryButton.url }}">{{ home.hero.secondaryButton.label }}</a>
      </div>
    </div>
  </div>
</section>

<section class="proof">
  <div class="wrap">
    <div class="proof__grid">
      {% for tile in home.proof %}
      <div class="proof__item">
        <span class="proof__num">{{ tile.figure }}</span>
        <span class="proof__label">{{ tile.label }}</span>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

{% if home.anniversary.show %}
<section class="anniversary">
  <div class="wrap">
    <img class="anniversary__mark" src="{{ site.logoLarge }}"
         alt="Westside Warriors 20th Anniversary" width="554" height="640">
    <div>
      <span class="section__eyebrow">{{ home.anniversary.eyebrow }}</span>
      <h2>{{ home.anniversary.heading }}</h2>
      {{ home.anniversary.body | markdown | safe }}
    </div>
  </div>
</section>
{% endif %}

<section class="section">
  <div class="wrap">
    <div class="doors">
      {% for door in home.doors %}
      <a class="door" href="{{ door.url }}">
        <h3>{{ door.heading }}</h3>
        <p>{{ door.text }}</p>
        <span class="door__more">{{ door.linkText }}</span>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section section--alt">
  <div class="wrap">
    <div class="section__head">
      <span class="section__eyebrow">{{ home.why.eyebrow }}</span>
      <h2>{{ home.why.heading }}</h2>
      <p class="section__lede">{{ home.why.lede }}</p>
    </div>

    <ul class="marks">
      {% for mark in home.why.marks %}
      <li><strong>{{ mark.heading }}</strong><span>{{ mark.text }}</span></li>
      {% endfor %}
    </ul>

    <div class="btn-row">
      <a class="btn" href="{{ home.why.buttonUrl }}">{{ home.why.buttonLabel }}</a>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="grid grid--2">
      <div>
        <span class="section__eyebrow">{{ home.goals.eyebrow }}</span>
        <h2>{{ home.goals.heading }}</h2>
        <ul>
          {% for goal in home.goals.items %}
          <li>{{ goal }}</li>
          {% endfor %}
        </ul>
        <div class="btn-row">
          <a class="btn btn--ghost" href="{{ home.goals.buttonUrl }}">{{ home.goals.buttonLabel }}</a>
        </div>
      </div>
      <div class="card">
        <h3>The school day</h3>
        <div class="table-wrap">
          <table>
            <tbody>
              <tr><th scope="row">Doors open / school begins</th><td>{{ site.schoolDay.start }}</td></tr>
              <tr><th scope="row">Elementary dismissal (K5&ndash;5)</th><td>{{ site.schoolDay.elementaryEnd }}</td></tr>
              <tr><th scope="row">Secondary dismissal (6&ndash;12)</th><td>{{ site.schoolDay.secondaryEnd }}</td></tr>
              <tr><th scope="row">Office hours</th><td>{{ site.contact.officeHours }}</td></tr>
            </tbody>
          </table>
        </div>
        <p><a href="/families/">All family resources</a></p>
      </div>
    </div>
  </div>
</section>

<section class="section section--ink">
  <div class="wrap wrap--narrow u-center">
    <span class="section__eyebrow">{{ home.ministry.eyebrow }}</span>
    <h2>{{ home.ministry.heading }}</h2>
    <p>{{ home.ministry.text }}</p>
    <div class="btn-row btn-row--center">
      <a class="btn" href="{{ home.ministry.primaryButton.url }}">{{ home.ministry.primaryButton.label }}</a>
      <a class="btn btn--light" href="{{ site.church.url }}">Visit the Church</a>
    </div>
  </div>
</section>

<section class="cta-band">
  <div class="wrap">
    <h2>{{ home.callToAction.heading }}</h2>
    <p>{{ home.callToAction.text }}</p>
    <div class="btn-row">
      <a class="btn btn--light" href="{{ home.callToAction.buttonUrl }}">{{ home.callToAction.buttonLabel }}</a>
      <a class="btn btn--light" href="tel:{{ site.contact.phoneHref }}">{{ site.contact.phone }}</a>
    </div>
  </div>
</section>
