---
layout: layouts/base.njk
title: Current Families
description: Calendar, forms, attendance policy, supply lists and everything else Westside Baptist Academy families need during the week.
permalink: /families/
---

{# Wording comes from src/_data/families.json so it can be edited in the CMS. #}

<div class="page-head">
  <div class="wrap">
    <span class="section__eyebrow">Current Families</span>
    <h1>Family Resources</h1>
    <p class="page-head__lede">{{ families.lede }}</p>
  </div>
</div>

<div class="section">
  <div class="wrap">
    <div class="doors">
      {# %HOMEWORK% resolves to site.homeworkUrl, so the Warrior Hub address
         lives in School Information and changes in exactly one place. #}
      {% for door in families.doors %}
      <a class="door" href="{{ door.url | replace('%HOMEWORK%', site.homeworkUrl) }}"{% if '%HOMEWORK%' in door.url %} rel="noopener"{% endif %}>
        <h3>{{ door.heading }}</h3>
        <p>{{ door.text }}</p>
        <span class="door__more">{{ door.linkText }}</span>
      </a>
      {% endfor %}
    </div>
  </div>
</div>

<div class="section section--alt">
  <div class="wrap">
    <div class="grid grid--2">

      <div class="card">
        <h3>The school day</h3>
        <div class="table-wrap">
          <table>
            <tbody>
              <tr><th scope="row">School office opens</th><td>7:35 AM</td></tr>
              <tr><th scope="row">School begins</th><td>{{ site.schoolDay.start }}</td></tr>
              <tr><th scope="row">Elementary dismissal (K5&ndash;5)</th><td>{{ site.schoolDay.elementaryEnd }}</td></tr>
              <tr><th scope="row">Secondary dismissal (6&ndash;12)</th><td>{{ site.schoolDay.secondaryEnd }}</td></tr>
              <tr><th scope="row">All students picked up by</th><td>3:25 PM</td></tr>
              <tr><th scope="row">Office closes</th><td>3:30 PM</td></tr>
            </tbody>
          </table>
        </div>
        <p class="card__meta">{{ families.schoolDayNote }}</p>
      </div>

      <div class="card">
        <h3>If school closes</h3>
        <p>When school closes for weather or another emergency, check in this order:</p>
        <ol class="list-tight">
          {% for step in families.closureSteps %}
          <li>{{ step }}</li>
          {% endfor %}
        </ol>
      </div>

      {% for card in families.cards %}
      <div class="card">
        <h3>{{ card.heading }}</h3>
        {{ card.body | markdown | safe }}
      </div>
      {% endfor %}

    </div>
  </div>
</div>
