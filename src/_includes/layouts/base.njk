<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} — {{ site.name }}{% else %}{{ site.name }} — Christian School in Katy, TX{% endif %}</title>
<meta name="description" content="{{ description or site.purpose }}">

{# Search engines are told to ignore a page in two cases:
   - the whole preview site, which must never compete with the live one;
   - any single page with `noindex: true` in its front matter.
   This is a meta tag rather than a robots.txt rule on purpose. Blocking a
   page in robots.txt stops Google reading it at all, so it never sees the
   instruction not to list it — and the bare URL can still show up in results.
   The tag is the thing that actually removes a page. #}
{% if env.preview or noindex %}<meta name="robots" content="noindex, nofollow">{% endif %}

{# The site answers on both wba.school and www.wba.school. Without this,
   search engines treat them as two separate sites with identical content and
   split the credit between them. This names the wba.school copy as the real
   one. #}
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<link rel="stylesheet" href="/assets/css/site.css">
{% include "partials/theme.njk" %}
{# The school crest, at the sizes each place actually uses. The .ico carries
   16/32/48/64 for browser tabs; the 180 is what iOS uses when a parent adds
   the site to their home screen. #}
<link rel="icon" href="/assets/img/favicon.ico" sizes="any">
<link rel="icon" href="/assets/img/favicon-32.png" type="image/png" sizes="32x32">
<link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<meta name="theme-color" content="#C30D11">
{# What a link to the school looks like when a parent texts it to a friend or
   posts it in a church group. Without og:image it is a bare grey rectangle. #}
<meta property="og:title" content="{{ title or site.name }}">
<meta property="og:description" content="{{ description or site.purpose }}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:locale" content="en_US">
<meta property="og:image" content="{{ site.url }}{{ site.shareImage }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="The Westside Baptist Academy campus in Katy, Texas.">
<meta name="twitter:card" content="summary_large_image">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "School",
  "name": "{{ site.name }}",
  "description": "{{ site.purpose }}",
  "url": "{{ site.url }}",
  "logo": "{{ site.url }}{{ site.logoLarge }}",
  "image": "{{ site.url }}{{ site.shareImage }}",
  "foundingDate": "{{ site.founded }}",
  "telephone": "{{ site.contact.phone }}",
  "email": "{{ site.contact.email }}",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "{{ site.contact.street }}",
    "addressLocality": "{{ site.contact.city }}",
    "addressRegion": "{{ site.contact.state }}",
    "postalCode": "{{ site.contact.zip }}",
    "addressCountry": "US"
  },
  "parentOrganization": {
    "@type": "Church",
    "name": "{{ site.church.name }}",
    "url": "{{ site.church.url }}"
  }
}
</script>
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
{% include "partials/preview-ribbon.njk" %}
{% include "partials/alert.njk" %}
{% include "partials/header.njk" %}
<main id="main">
{{ content | safe }}
</main>
{% include "partials/footer.njk" %}
<script src="/assets/js/site.js" defer></script>
</body>
</html>
