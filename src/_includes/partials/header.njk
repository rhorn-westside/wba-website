<div class="ministry-band">
  <div class="wrap">
    <span>A ministry of <a href="{{ site.church.url }}">{{ site.church.name }}</a> &middot; Katy, Texas</span>
    <span class="ministry-band__contact">
      <a href="tel:{{ site.contact.phoneHref }}">{{ site.contact.phone }}</a>
    </span>
  </div>
</div>

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href="/">
      <img class="brand__mark" src="{{ site.logo }}" alt="">
      <span class="brand__text">
        <span class="brand__name">Westside Baptist Academy</span>
        <span class="brand__sub">Katy, Texas &middot; K5&ndash;12</span>
      </span>
    </a>

    <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="primary-nav">
      <span class="nav-toggle__bars" aria-hidden="true"></span>
      <span class="nav-toggle__label">Menu</span>
    </button>

    <nav class="primary-nav" id="primary-nav" aria-label="Main">
      <ul class="primary-nav__list">
        {% for item in nav.items %}
        <li class="primary-nav__item{% if item.children %} has-children{% endif %}">
          <a href="{{ item.url }}"{% if page.url.startsWith(item.url) and item.url != "/" %} aria-current="true"{% endif %}>{{ item.title }}</a>
          {% if item.children %}
          <ul class="subnav">
            {% for child in item.children %}
            <li><a href="{{ child.url }}">{{ child.title }}</a></li>
            {% endfor %}
          </ul>
          {% endif %}
        </li>
        {% endfor %}
        <li class="primary-nav__item primary-nav__item--cta">
          <a class="btn btn--sm" href="/admissions/visit/">Schedule a Tour</a>
        </li>
      </ul>
    </nav>
  </div>
</header>
