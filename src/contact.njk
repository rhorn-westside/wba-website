---
layout: layouts/base.njk
title: Contact
description: Contact Westside Baptist Academy in Katy, Texas — phone, email, address and office hours.
permalink: /contact/
---

{# Wording on this page comes from src/_data/contact.json so it can be edited
   in the CMS. Phone, address, hours and service times come from site.json. #}

<div class="page-head">
  <div class="wrap">
    <h1>Contact Us</h1>
    <p class="page-head__lede">{{ contact.lede }}</p>
  </div>
</div>

<div class="section">
  <div class="wrap">
    <div class="grid grid--3">

      <div class="card">
        <h3>School Office</h3>
        <p>
          <a href="tel:{{ site.contact.phoneHref }}">{{ site.contact.phone }}</a><br>
          <a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a>
        </p>
        <p class="card__meta">{{ site.contact.officeHours }}</p>
      </div>

      <div class="card">
        <h3>Campus</h3>
        <address>
          {{ site.contact.street }}<br>
          {{ site.contact.city }}, {{ site.contact.state }} {{ site.contact.zip }}
        </address>
        <p><a href="https://maps.google.com/?q={{ site.contact.street | urlencode }},+{{ site.contact.city }},+{{ site.contact.state }}+{{ site.contact.zip }}">Directions &rarr;</a></p>
      </div>

      <div class="card">
        <h3>{{ contact.visiting.heading }}</h3>
        <p>{{ contact.visiting.text }}</p>
        <p><a href="/admissions/visit/">Schedule a tour &rarr;</a></p>
      </div>

    </div>

    <div class="grid grid--2 u-mt-lg">

      <div class="prose">
        <h2>Who to ask</h2>
        <table>
          <tbody>
            {% for row in contact.whoToAsk %}
            <tr><th scope="row">{{ row.topic }}</th><td>{{ row.who }}</td></tr>
            {% endfor %}
          </tbody>
        </table>

        <h2>{{ contact.employment.heading }}</h2>
        <p>{{ contact.employment.text }} Inquiries to <a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a>.</p>
      </div>

      <div class="prose">
        <h2>Church service times</h2>
        <table>
          <tbody>
            {% for s in site.church.services %}
            <tr><th scope="row">{{ s.name }}</th><td>{{ s.time }}</td></tr>
            {% endfor %}
            {% if contact.extraService.name %}
            <tr><th scope="row">{{ contact.extraService.name }}</th><td>{{ contact.extraService.time }}</td></tr>
            {% endif %}
          </tbody>
        </table>
        <p>{{ contact.servicesNote }}</p>
      </div>

    </div>

    <div class="prose u-mt-md">
      {% todo "Map and photo" %}
      <p>An embedded map and a photograph of the campus entrance both belong on this page. A picture of the door a visitor should walk through removes real friction on the day of a tour.</p>
      {% endtodo %}
    </div>

  </div>
</div>
