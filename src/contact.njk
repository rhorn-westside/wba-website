---
layout: layouts/base.njk
title: Contact
description: Contact Westside Baptist Academy in Katy, Texas — phone, email, address and office hours.
permalink: /contact/
---

{# Wording on this page comes from src/_data/contact.json so it can be edited
   in the CMS. Phone, address, hours and service times come from site.json. #}

<div class="page-head">
  <div class="wrap">
    <h1>Contact Us</h1>
    <p class="page-head__lede">{{ contact.lede }}</p>
  </div>
</div>

{# The campus photograph. Three widths are on disk; the browser picks the
   smallest one that still looks sharp, so a parent on a phone downloads
   44 KB rather than 200 KB. WebP first, JPEG for anything that cannot
   read it. The caption is editable in the CMS and is left out when empty. #}
<div class="wrap">
  <figure class="campus-photo">
    <picture>
      <source
        type="image/webp"
        srcset="/assets/img/campus-640.webp 640w,
                /assets/img/campus-1000.webp 1000w,
                /assets/img/campus-1600.webp 1600w"
        sizes="(min-width: 1100px) 1040px, 100vw">
      <img
        src="/assets/img/campus-1000.jpg"
        srcset="/assets/img/campus-640.jpg 640w,
                /assets/img/campus-1000.jpg 1000w,
                /assets/img/campus-1600.jpg 1600w"
        sizes="(min-width: 1100px) 1040px, 100vw"
        width="4024" height="1821"
        alt="The Westside Baptist Academy campus: a single-storey red brick building with a covered walkway along the front, a large oak tree, and visitor parking directly in front of the entrance."
        loading="eager"
        decoding="async">
    </picture>
    {% if contact.photoCaption %}
    <figcaption>{{ contact.photoCaption }}</figcaption>
    {% endif %}
  </figure>
</div>

<div class="section">
  <div class="wrap">
    <div class="grid grid--3">

      <div class="card">
        <h3>School Office</h3>
        <p>
          <a href="tel:{{ site.contact.phoneHref }}">{{ site.contact.phone }}</a><br>
          <a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a>
        </p>
        <p class="card__meta">{{ site.contact.officeHours }}</p>
      </div>

      <div class="card">
        <h3>Campus</h3>
        <address>
          {{ site.contact.street }}<br>
          {{ site.contact.city }}, {{ site.contact.state }} {{ site.contact.zip }}
        </address>
        <p><a href="https://maps.google.com/?q={{ site.contact.street | urlencode }},+{{ site.contact.city }},+{{ site.contact.state }}+{{ site.contact.zip }}">Directions &rarr;</a></p>
      </div>

      <div class="card">
        <h3>{{ contact.visiting.heading }}</h3>
        <p>{{ contact.visiting.text }}</p>
        <p><a href="/admissions/visit/">Schedule a tour &rarr;</a></p>
      </div>

    </div>

    <div class="grid grid--2 u-mt-lg">

      <div class="prose">
        <h2>Who to ask</h2>
        <table>
          <tbody>
            {% for row in contact.whoToAsk %}
            <tr><th scope="row">{{ row.topic }}</th><td>{{ row.who }}</td></tr>
            {% endfor %}
          </tbody>
        </table>

        <h2>{{ contact.employment.heading }}</h2>
        <p>{{ contact.employment.text }} Inquiries to <a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a>.</p>
      </div>

      <div class="prose">
        <h2>Church service times</h2>
        <table>
          <tbody>
            {% for s in site.church.services %}
            <tr><th scope="row">{{ s.name }}</th><td>{{ s.time }}</td></tr>
            {% endfor %}
            {% if contact.extraService.name %}
            <tr><th scope="row">{{ contact.extraService.name }}</th><td>{{ contact.extraService.time }}</td></tr>
            {% endif %}
          </tbody>
        </table>
        <p>{{ contact.servicesNote }}</p>
      </div>

    </div>

    {# The wrapper is inside the condition too, so the live page has no empty
       div left behind holding open a margin. #}
    {% if env.preview %}
    <div class="prose u-mt-md">
      {% todo "Close-up of the entrance" %}
      <p>The campus photograph above is in place. What it does not do is show a first-time visitor <em>which door</em> — the entrance reads as a dark recess behind the tree at this scale.</p>
      <p>A second, closer photograph of the main front doors would finish the job, along with a caption on the photo above. Set the caption under Contact Page in the CMS.</p>
      {% endtodo %}
    </div>
    {% endif %}

  </div>
</div>
