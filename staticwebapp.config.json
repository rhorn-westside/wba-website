{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "trailingSlash": "always",
  "navigationFallback": {
    "rewrite": "/404.html",
    "exclude": [
      "/assets/*",
      "/files/*",
      "*.{png,jpg,jpeg,svg,webp,ico,pdf,css,js,xml,txt}"
    ]
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html",
      "statusCode": 404
    }
  },
  "routes": [
    {
      "route": "/academics/grading/*",
      "redirect": "/families/grading/",
      "statusCode": 301
    },
    {
      "route": "/api/inquiry",
      "methods": [
        "POST"
      ],
      "allowedRoles": [
        "anonymous"
      ]
    },
    {
      "route": "/wba/*",
      "redirect": "/",
      "statusCode": 301
    }
  ],
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "SAMEORIGIN",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "geolocation=(), microphone=(), camera=()",
    "Strict-Transport-Security": "max-age=31536000; includeSubDomains",
    "Content-Security-Policy": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
  },
  "platform": {
    "apiRuntime": "node:20"
  },
  "mimeTypes": {
    ".webmanifest": "application/manifest+json",
    ".svg": "image/svg+xml"
  }
}
